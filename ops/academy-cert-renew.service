[Unit]
Description=Renew Academy HTTPS certificate
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/opt/academy-certbot/bin/certbot renew --quiet --no-random-sleep-on-renew --deploy-hook "/usr/bin/docker compose -p academy-tls -f /opt/masshtab-academy/ops/hh-tls.compose.yml exec -T tls nginx -s reload"
